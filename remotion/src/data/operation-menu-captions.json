      {
        "text": "for over a year.",
        "start": 7.07,
        "end": 8.3
      }
    ],
    "02": [
      {
        "text": "The reports said South Vietnam.",
        "start": 0.0,
        "end": 1.87
      },
      {
        "text": "The bombs fell on Cambodia.",
        "start": 2.11,
        "end": 3.66
      },
      {
        "text": "The real records were burned.",
        "start": 4.05,
        "end": 5.59
      }
    ],
    "03": [
      {
        "text": "3,875 B-52 sorties.",
        "start": 0.11,
