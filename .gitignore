# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# remotion
remotion/node_modules/
remotion/out/
remotion/public/audio/*.mp3
verify-*.png
*.tmp.jpg
diff-output.txt

# python venvs (chatterbox TTS, whisper alignment)
chatterbox-env/
whisper-env/

# generated media / scratch outputs
*.mp4
*.wav
voice-tests/

# python bytecode cache
__pycache__/
*.pyc

# video production (not part of the site)
/remotion/
/voices/
/voice-tests/

# root-level scratch: media, reports, logs, research
/*.jpg
/*.png
/*.pdf
/*.mp3
/*.wav
/*.log
/*.svg
/03-source-card.json
/pacing_report.txt

# root-level helper scripts (voiceover, video prep, tracing)
/*.py
